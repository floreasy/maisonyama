<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="canonical" href="{{ canonical_url }}">
<link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

{% render 'ym-favicon' %}

<title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
{%- if page_description -%}
  <meta name="description" content="{{ page_description | escape }}">
{%- endif -%}

{% render 'ym-meta-tags' %}
{% render 'ym-fonts' %}

{{ 'base.css' | asset_url | stylesheet_tag }}
{{ 'sections.css' | asset_url | stylesheet_tag }}

<script>
  /* Exposé au JS du thème : routes localisées et libellés traduisibles. */
  window.YM = {
    routes: {
      cart_add: '{{ routes.cart_add_url }}',
      cart_change: '{{ routes.cart_change_url }}',
      cart: '{{ routes.cart_url }}'
    },
    strings: {
      cartError: {{ 'panier.erreur' | t | json }},
      added: {{ 'panier.ajoute' | t | json }}
    }
  };
</script>

{{ content_for_header }}
</head>

<body class="template-{{ template.name | handle }}">

<a class="ym-skip" href="#ym-main">Aller au contenu</a>

{% sections 'header-group' %}

<main id="ym-main">
  {{ content_for_layout }}
</main>

{% sections 'footer-group' %}

{% section 'ym-cart-drawer' %}

{%- comment -%} Quatre fichiers, aucun cadre : passage de page, navigation, loupe, panier. Chacun sort immédiatement si la page ne le concerne pas. {%- endcomment -%}
<script src="{{ 'transitions.js' | asset_url }}" defer></script>
<script src="{{ 'nav.js' | asset_url }}" defer></script>
<script src="{{ 'gallery.js' | asset_url }}" defer></script>
<script src="{{ 'cart.js' | asset_url }}" defer></script>
</body>
</html>
