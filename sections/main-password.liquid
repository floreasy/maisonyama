{%- comment -%}
  Page mot de passe : ce que voit un visiteur tant que la boutique est fermée.
  Volontairement sans en-tête ni menu — il n'y a rien à parcourir derrière.
{%- endcomment -%}
<section class="ym-password">
  {%- render 'ym-image',
      image: section.settings.image,
      repli: 'decor-olivia.jpg', repli_l: 1600, repli_h: 1067,
      alt: section.settings.image_alt,
      eager: true -%}
  <div class="ym-password-veil"></div>

  <div class="ym-password-copy">
    {%- if settings.logo_footer != blank -%}
      {{ settings.logo_footer | image_url: width: 330 | image_tag:
           class: 'ym-password-logo', widths: '132, 220, 330', sizes: '165px', alt: shop.name }}
    {%- else -%}
      <img class="ym-password-logo" src="{{ 'logo-principal-blanc.png' | asset_url }}" alt="{{ shop.name }}" width="1100" height="623">
    {%- endif -%}

    {%- if section.settings.surtitre != blank -%}
      <div class="ym-eyebrow">{{ section.settings.surtitre }}</div>
    {%- endif -%}
    <h1>{{ section.settings.titre }}</h1>
    <div class="ym-rule"></div>
    {%- if section.settings.texte != blank -%}<p>{{ section.settings.texte }}</p>{%- endif -%}

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <p class="ym-form-error" role="alert">{{ 'mot_de_passe.erreur' | t }}</p>
      {%- endif -%}
      <div class="ym-password-form">
        <label class="ym-visually-hidden" for="ym-mdp">{{ section.settings.champ_libelle }}</label>
        <input id="ym-mdp" type="password" name="password" autocomplete="current-password"
               placeholder="{{ section.settings.champ_libelle | escape }}">
        <button class="ym-cta" type="submit">{{ section.settings.bouton }}</button>
      </div>
    {%- endform -%}
  </div>

  <div class="ym-password-foot">
    {{ shop.name }} · {{ powered_by_link }}
  </div>
</section>

{% schema %}
{
  "name": "Page mot de passe",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo de fond" },
    { "type": "text", "id": "image_alt", "label": "Description de l'image", "default": "Chemin de lavande dans le Luberon" },
    { "type": "text", "id": "surtitre", "label": "Surtitre", "default": "Ouverture prochaine" },
    { "type": "text", "id": "titre", "label": "Titre", "default": "La collection se prépare." },
    { "type": "textarea", "id": "texte", "label": "Texte", "default": "Sept broches tissées à la main au cœur du Luberon. Encore un peu de patience." },
    { "type": "text", "id": "champ_libelle", "label": "Libellé du champ", "default": "Mot de passe" },
    { "type": "text", "id": "bouton", "label": "Bouton", "default": "Entrer" }
  ]
}
{% endschema %}
