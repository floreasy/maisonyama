{%- comment -%} Page panier : le filet de sécurité quand le JS ne répond pas, et la page vers laquelle pointe l'en-tête. {%- endcomment -%}
<section class="ym-cart-page">
  <div class="ym-container">
    <div class="ym-eyebrow">{{ shop.name }}</div>
    <h1>{{ 'panier.titre' | t }}</h1>
    <div class="ym-rule"></div>

    {%- if cart.item_count == 0 -%}
      <p class="ym-cart-empty">{{ 'panier.vide' | t }}</p>
      <a class="ym-cta" href="{{ routes.all_products_collection_url }}">{{ 'panier.vide_lien' | t }}</a>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <div class="ym-cart-lines">
          {%- for item in cart.items -%}
            {%- render 'ym-ligne-panier', item: item -%}
          {%- endfor -%}
        </div>

        <div class="ym-cart-foot">
          <div class="ym-drawer-total">
            <span>{{ 'panier.sous_total' | t }}</span>
            <span class="ym-price">{{ cart.total_price | money }}</span>
          </div>
          <p class="ym-drawer-note">{{ 'panier.note_livraison' | t }}</p>
          <button class="ym-cta" type="submit" name="checkout">{{ 'panier.commander' | t }}</button>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Panier", "settings": [] }
{% endschema %}
