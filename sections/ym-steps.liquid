{%- comment -%}
  Les temps du savoir-faire : une suite d'étapes en texte seul. Le numéro doré
  tient la colonne de gauche en desktop, passe au-dessus du texte en mobile ;
  un filet sépare chaque temps du suivant.
{%- endcomment -%}

<section class="ym-steps">
  <div class="ym-container">
    <ol class="ym-steps-list">
      {%- for block in section.blocks -%}
        <li class="ym-step" {{ block.shopify_attributes }}>
          {%- if block.settings.numero != blank -%}
            <div class="ym-step-number">{{ block.settings.numero }}</div>
          {%- endif -%}
          <div class="ym-step-copy">
            {%- if block.settings.surtitre != blank -%}
              <div class="ym-eyebrow">{{ block.settings.surtitre }}</div>
            {%- endif -%}
            <h2>{{ block.settings.titre }}</h2>
            {{ block.settings.texte }}
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Les temps du savoir-faire",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "etape",
      "name": "Étape",
      "settings": [
        { "type": "text", "id": "numero", "label": "Numéro", "default": "01" },
        { "type": "text", "id": "surtitre", "label": "Surtitre", "default": "L'observation" },
        { "type": "text", "id": "titre", "label": "Titre", "default": "Tout commence dehors." },
        { "type": "richtext", "id": "texte", "label": "Texte" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Les temps du savoir-faire",
      "blocks": [
        { "type": "etape", "settings": { "numero": "01", "surtitre": "L'observation", "titre": "Tout commence dehors.", "texte": "<p>Les champs, les haies, les toits du village. On note une posture, un éclat de plumage, la courbe d'une tige — le motif existe avant la première perle.</p>" } },
        { "type": "etape", "settings": { "numero": "02", "surtitre": "La composition", "titre": "Choisir chaque couleur, une à une.", "texte": "<p>Le dessin fixe la silhouette, puis vient la palette : des perles de rocaille triées par teinte et par finition — mates, nacrées, irisées — pour capter la lumière comme le ferait le vivant.</p>" } },
        { "type": "etape", "settings": { "numero": "03", "surtitre": "Le tissage", "titre": "Perle après perle, à l'aiguille.", "texte": "<p>Chaque perle est cousue à sa voisine, rang après rang, jusqu'à ce que le motif prenne corps. Une cigale en demande 599 — et plusieurs heures de tissage ininterrompu.</p>" } },
        { "type": "etape", "settings": { "numero": "04", "surtitre": "Les finitions", "titre": "Doublée, montée, mise en écrin.", "texte": "<p>Le tissage est doublé pour tenir sa forme, l'attache est cousue à la main, puis la broche rejoint son écrin vert amande — dernière étape avant de quitter l'atelier.</p>" } }
      ]
    }
  ]
}
{% endschema %}
