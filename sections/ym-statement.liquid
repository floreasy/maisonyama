{%- comment -%} Manifeste centré. L'italique se pose avec le <em> de l'éditeur de texte enrichi. {%- endcomment -%}
<section class="ym-statement">
  <div class="ym-container">
    <div class="ym-rule"></div>
    <p>{{ section.settings.texte }}</p>
    {%- if section.settings.mention != blank -%}
      <div class="ym-statement-foot">{{ section.settings.mention }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Manifeste",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "texte",
      "label": "Texte",
      "info": "Mettez en italique le fragment à faire ressortir.",
      "default": "De véritables bijoux vestimentaires qui épousent les courbes naturellement.<br>Des fragments de la Provence qui accompagnent notre quotidien."
    },
    { "type": "text", "id": "mention", "label": "Mention en bas", "default": "Une présence délicate au quotidien" }
  ],
  "presets": [{ "name": "Manifeste" }]
}
{% endschema %}
